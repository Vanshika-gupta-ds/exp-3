<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dynamic To-Do List</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .container {
      background: white;
      width: 100%;
      max-width: 480px;
      padding: 30px;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    h1 {
      text-align: center;
      color: #333;
      margin-bottom: 10px;
    }

    .subtitle {
      text-align: center;
      color: #777;
      margin-bottom: 25px;
    }

    .input-group {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }

    #taskInput {
      flex: 1;
      min-width: 0;
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 16px;
      outline: none;
    }

    #taskInput:focus {
      border-color: #667eea;
    }

    button {
      border: none;
      cursor: pointer;
      border-radius: 8px;
      font-size: 14px;
      transition: 0.2s;
    }

    #addBtn {
      padding: 12px 16px;
      color: white;
      background: #667eea;
    }

    #addBtn:hover {
      background: #5365d8;
    }

    #taskList {
      list-style: none;
    }

    .task-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 10px;
      border-bottom: 1px solid #eee;
    }

    .task-checkbox {
      width: 18px;
      height: 18px;
      cursor: pointer;
      accent-color: #667eea;
      flex-shrink: 0;
    }

    .task-text {
      flex: 1;
      overflow-wrap: anywhere;
      color: #333;
    }

    .completed .task-text {
      text-decoration: line-through;
      color: #999;
    }

    .delete-btn {
      padding: 7px 10px;
      background: #ffe5e5;
      color: #d33;
    }

    .delete-btn:hover {
      background: #ffcccc;
    }

    #emptyMessage {
      text-align: center;
      color: #999;
      padding: 20px 0;
    }

    .stats {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin-top: 22px;
      padding-top: 15px;
      border-top: 1px solid #eee;
      font-size: 13px;
      color: #666;
    }

    .stats strong {
      color: #667eea;
    }

    @media (max-width: 400px) {
      .container {
        padding: 20px;
      }

      .input-group {
        flex-wrap: wrap;
      }

      #taskInput {
        width: 100%;
        flex-basis: 100%;
      }

      #addBtn {
        width: 100%;
      }

      .stats {
        flex-wrap: wrap;
      }
    }
  </style>
</head>

<body>
  <main class="container">
    <h1>📝 My To-Do List</h1>
    <p class="subtitle">Organize your day, one task at a time.</p>

    <div class="input-group">
      <input
        type="text"
        id="taskInput"
        placeholder="Enter a new task..."
        aria-label="New task"
      >
      <button id="addBtn" type="button">+ Add Task</button>
    </div>

    <ul id="taskList"></ul>

    <p id="emptyMessage">No tasks yet. Add your first task!</p>

    <div class="stats">
      <span>Total: <strong id="totalTasks">0</strong></span>
      <span>Completed: <strong id="completedTasks">0</strong></span>
      <span>Pending: <strong id="pendingTasks">0</strong></span>
    </div>
  </main>

  <script>
    // Select HTML elements using the DOM
    const taskInput = document.getElementById("taskInput");
    const addBtn = document.getElementById("addBtn");
    const taskList = document.getElementById("taskList");
    const emptyMessage = document.getElementById("emptyMessage");

    const totalTasks = document.getElementById("totalTasks");
    const completedTasks = document.getElementById("completedTasks");
    const pendingTasks = document.getElementById("pendingTasks");

    // Add a new task
    function addTask() {
      const taskText = taskInput.value.trim();

      // Prevent empty tasks
      if (taskText === "") {
        taskInput.focus();
        return;
      }

      // Create a new list item
      const li = document.createElement("li");
      li.className = "task-item";

      // Create a checkbox
      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.className = "task-checkbox";
      checkbox.setAttribute("aria-label", "Mark task completed");

      // Create task text safely
      const span = document.createElement("span");
      span.className = "task-text";
      span.textContent = taskText;

      // Create delete button
      const deleteBtn = document.createElement("button");
      deleteBtn.className = "delete-btn";
      deleteBtn.textContent = "Delete";
      deleteBtn.type = "button";
      deleteBtn.setAttribute("aria-label", "Delete task");

      // Mark task as completed or pending
      checkbox.addEventListener("change", function () {
        li.classList.toggle("completed", checkbox.checked);
        updateStats();
      });

      // Delete the task
      deleteBtn.addEventListener("click", function () {
        li.remove();
        updateStats();
      });

      // Add elements to the list item
      li.appendChild(checkbox);
      li.appendChild(span);
      li.appendChild(deleteBtn);

      // Add task to the page
      taskList.appendChild(li);

      // Clear input and update the interface
      taskInput.value = "";
      taskInput.focus();
      updateStats();
    }

    // Update task counters
    function updateStats() {
      const tasks = taskList.querySelectorAll(".task-item");
      const completed = taskList.querySelectorAll(
        ".task-checkbox:checked"
      ).length;

      totalTasks.textContent = tasks.length;
      completedTasks.textContent = completed;
      pendingTasks.textContent = tasks.length - completed;

      emptyMessage.style.display =
        tasks.length === 0 ? "block" : "none";
    }

    // Handle button click
    addBtn.addEventListener("click", addTask);

    // Handle Enter key
    taskInput.addEventListener("keydown", function (event) {
      if (event.key === "Enter") {
        addTask();
      }
    });

    // Initialize counters
    updateStats();
  </script>
</body>
</html>
